<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>@APP_NAME@</string>
  <key>CFBundleDisplayName</key><string>@APP_NAME@</string>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleExecutable</key><string>@APP_NAME@</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>2</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>@APP_NAME@ opens the Auto-Align Post panel in DaVinci Resolve for you.</string>
  <key>NSRemovableVolumesUsageDescription</key><string>@APP_NAME@ reads camera cards and sound drives you drop in.</string>
  <key>NSDesktopFolderUsageDescription</key><string>@APP_NAME@ reads and writes the media folders you choose.</string>
  <key>NSDocumentsFolderUsageDescription</key><string>@APP_NAME@ reads and writes the media folders you choose.</string>
  <key>NSDownloadsFolderUsageDescription</key><string>@APP_NAME@ reads and writes the media folders you choose.</string>
</dict>
</plist>
